# Drizzle — read-only against the legacy database. Never run db:push / db:generate.
DATABASE_URL="mysql://root:rootpassword@localhost:3306/dad_db"

# Legacy site that still serves media from its filesystem (nginx).
MEDIA_BASE_URL="http://localhost:8000"

# --- Production (VPS / PM2). Vite ignores these in `npm run dev`. ---
# Must match nginx `proxy_pass` (this app uses 3003).
# HOST=127.0.0.1
# PORT=3003
# Trust nginx for HTTPS and Cloudflare for the visitor IP.
# PROTOCOL_HEADER=x-forwarded-proto
# ADDRESS_HEADER=CF-Connecting-IP

# Optional override for backoffice / score-report / flash-interview links (defaults to MEDIA_BASE_URL).
# LEGACY_BASE_URL="http://localhost:8000"

# Construction notice pinned as the second item on the home feed. Set to false to remove it.
NEW_SITE_DISCLAIMER_ENABLED=true

# Optional feedback form shown as a link on that disclaimer (Google Forms or similar). Leave empty to hide it.
FEEDBACK_FORM_URL=

# Social login buttons on /conta (Facebook off — legacy provider has been broken for a long time).
SOCIAL_LOGINS_ENABLED=true
GOOGLE_LOGIN_ENABLED=true
FACEBOOK_LOGIN_ENABLED=false
APPLE_LOGIN_ENABLED=false

# Signed session cookie for the new app (change in production).
SESSION_SECRET="dev-only-session-secret-change-me!!"

# Google OAuth (optional — leave empty to hide working Google login until configured).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_CALLBACK=http://localhost:5173/conta/entrar/google/callback

# reCAPTCHA v2 checkbox. Legacy names RECAPTCHA_PUBLIC_KEY / RECAPTCHA_PRIVATE_KEY also work.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# SMTP mail (same keys as the legacy Laravel site). Used for email verification on register.
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=geral@domingoasdez.com
MAIL_FROM_NAME="Domingo às Dez"
