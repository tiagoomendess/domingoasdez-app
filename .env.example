# Schema owned by domingoasdez-admin migrations: never run drizzle-kit push/generate/migrate here.
DATABASE_URL="mysql://root:rootpassword@localhost:3306/dad_db"

# Legacy site that still serves media from its filesystem (nginx).
MEDIA_BASE_URL="http://localhost:8000"

# Flip to true after media is on Cloudflare R2. Prefixes MEDIA_CDN_BASE_URL instead of
# MEDIA_BASE_URL; bucket keys mirror the DB paths (/storage/...), so paths are unchanged.
MEDIA_CDN_ENABLED=false
MEDIA_CDN_BASE_URL=https://cdn.domingoasdez.com

# --- Production (VPS / PM2). Vite ignores these in `npm run dev`. ---
# Must match nginx `proxy_pass` (this app uses 3003).
# HOST=127.0.0.1
# PORT=3003
# Trust nginx for HTTPS and Cloudflare for the visitor IP.
# PROTOCOL_HEADER=x-forwarded-proto
# ADDRESS_HEADER=CF-Connecting-IP

# Optional override for backoffice / score-report / flash-interview links (defaults to MEDIA_BASE_URL).
# LEGACY_BASE_URL="http://localhost:8000"

# Cloudflare R2 uploads (profile pictures). Same values as the admin app's .env.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto

# Logs. LOG_LEVEL: debug (also the /healthz checks) | info (one line per request) | warn | error.
# LOG_FORMAT: text (readable) | json (one object per line, read by Grafana Alloy: docs/logging.md in
# domingoasdez-admin). ecosystem.config.cjs sets json in production.
LOG_LEVEL=info
LOG_FORMAT=text

# Admin app that the "edit" shortcuts for admins point to.
ADMIN_BASE_URL="https://admin.domingoasdez.com"

# Construction notice pinned as the second item on the home feed. Set to false to remove it.
NEW_SITE_DISCLAIMER_ENABLED=true

# Optional feedback form shown as a link on that disclaimer (Google Forms or similar). Leave empty to hide it.
FEEDBACK_FORM_URL=

# Social login buttons on /conta (Facebook off — legacy provider has been broken for a long time).
SOCIAL_LOGINS_ENABLED=true
GOOGLE_LOGIN_ENABLED=true
FACEBOOK_LOGIN_ENABLED=false
APPLE_LOGIN_ENABLED=false

# Signed session cookie for the new app (change in production).
SESSION_SECRET="dev-only-session-secret-change-me!!"

# Google OAuth (optional — leave empty to hide working Google login until configured).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_CALLBACK=http://localhost:5173/conta/entrar/google/callback

# reCAPTCHA v2 checkbox. Legacy names RECAPTCHA_PUBLIC_KEY / RECAPTCHA_PRIVATE_KEY also work.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Google Analytics (GA4) and AdSense — same IDs as domingoasdez.com. Leave empty to disable.
# Scripts only load on app.domingoasdez.com / domingoasdez.com / www (never localhost).
#
# Before deploying, in the Google consoles:
# GA4 (property G-PPBRM1T8VZ):
#   - Admin → Data streams → web stream → Configure tag settings → Configure your domains:
#     add domingoasdez.com and app.domingoasdez.com
#   - Same place → List unwanted referrals: add domingoasdez.com (so hops between
#     the old site and app. do not start a new session)
#   - Do not create a second web stream; split reports by hostname during the overlap
# AdSense (pub-3518000096682897):
#   - Sites: leave domingoasdez.com only (subdomains are covered by the root site)
#   - Privacy & messaging: publish the existing EU Funding Choices message so it also
#     shows on app.domingoasdez.com (test in a private window)
#   - Auto ads: turn off Anchor and Vignette overlays before going live on the app —
#     they cover the bottom tab bar. Manual units stay; the old site can keep its footer unit
PUBLIC_GA_MEASUREMENT_ID=G-PPBRM1T8VZ
PUBLIC_ADSENSE_CLIENT=ca-pub-3518000096682897
# Set to false to turn off every AdSense ad on the public site (consent banner and GA keep working).
ADSENSE_ENABLED=true

# SMTP mail (same keys as the legacy Laravel site). Used for email verification on register.
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=geral@domingoasdez.com
MAIL_FROM_NAME="Domingo às Dez"
